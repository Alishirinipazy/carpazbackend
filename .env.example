# App
APP_NAME="Car Sales API"
APP_DEBUG=true

# Database (same MySQL DB the Laravel app used, or a fresh one)
DATABASE_URL=mysql://root:@127.0.0.1:3306/laravel

# Auth tokens
# Random long string used to hash/derive tokens - keep secret, rotate = invalidates all tokens
TOKEN_SECRET=change-this-to-a-long-random-string
TOKEN_EXPIRE_MINUTES=0
# 0 = tokens never expire (same default behavior as Laravel Sanctum here)

# SMS (Ghasedak) - used for OTP login and notifying sales agents of new inquiries
GHASEDAK_API_KEY=

# AI sales assistant (Claude API - https://console.anthropic.com)
ANTHROPIC_API_KEY=
AI_ASSISTANT_MODEL=claude-sonnet-5

# AI_PROVIDER=anthropic uses ANTHROPIC_API_KEY above.
# AI_PROVIDER=gapgpt uses GAPGPT_API_KEY/GAPGPT_MODEL instead (api.gapgpt.app,
# an OpenAI-compatible proxy - get a key at https://gapgpt.app).
AI_PROVIDER=anthropic
GAPGPT_API_KEY=
GAPGPT_MODEL=gpt-4o-mini

# CORS
CORS_ORIGINS=http://localhost:3000
